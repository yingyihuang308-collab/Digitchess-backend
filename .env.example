# Copy to .env; use a generated random hexadecimal password. Never commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DOMAIN=api.example.com
# UID/GID of the owner of .local/jwt-private.pem (id -u; id -g).
BACKEND_UID=1000
BACKEND_GID=1000
# Exact WebGL page origin; no path or trailing slash.
WEBGL_ORIGIN=https://play.example.com
